# Copy this file to .env and fill in your key(s):   cp .env.example .env
# .env is gitignored — never commit real keys.
# Note: the Streamlit app can instead take a key in its sidebar; .env is the
# fallback for the CLI, the eval, and local dev.

# --- Model provider (any OpenAI-compatible endpoint). You need ONE. ----------
# Ollama Cloud is the code's default (model gpt-oss:120b, base https://ollama.com/v1).
# Get a key at https://ollama.com → Settings → API keys.
OLLAMA_API_KEY=your-ollama-cloud-key

# Optional backup provider (DeepSeek, base https://api.deepseek.com).
DEEPSEEK_API_KEY=your-deepseek-key

# --- LangSmith tracing (OPTIONAL) --------------------------------------------
# Leave blank / delete this block to run without tracing.
# Get a key at https://smith.langchain.com → Settings → API Keys.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=ipl-analyst-agent
# Legacy aliases (some langchain versions read these instead):
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_PROJECT=ipl-analyst-agent
